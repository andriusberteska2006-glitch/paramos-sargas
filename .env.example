ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Email reminders. Redis: Vercel → Storage → Upstash for Redis (fills KV_REST_API_URL / KV_REST_API_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any random string of 16+ characters. Vercel Cron sends it as "Authorization: Bearer ..."; also signs unsubscribe links.
CRON_SECRET=
# Sender, e.g. "Paramos sargas <priminimai@jusu-domenas.lt>". Empty = onboarding@resend.dev, which only delivers to the Resend account owner.
REMIND_FROM=
